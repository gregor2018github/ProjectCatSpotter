cat_spotter/build/

# Dart tool cache
cat_spotter/.dart_tool/
cat_spotter/.flutter-plugins
cat_spotter/.flutter-plugins-dependencies
cat_spotter/.pub-cache/
cat_spotter/.pub/

# Generated files
cat_spotter/**/*.g.dart
cat_spotter/**/*.freezed.dart

# ─── Android ─────────────────────────────────────────────────────
# Gradle build output
cat_spotter/android/.gradle/
cat_spotter/android/app/build/
cat_spotter/android/build/

# Machine-local SDK paths (contains your PC's local paths)
cat_spotter/android/local.properties

# Key store secrets — never commit these
*.jks
*.keystore
key.properties

# ─── IDE / Editor ────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.user

# ─── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

